# 100% FREE LiveApp Server Configuration Template
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Database: SQLite built-in file (100% Free, zero setup)
# SQLITE_FILE=data/liveapp.db
# DATABASE_URL=

# Live Video & Audio: 100% FREE WebSocket WebRTC (P2P Mesh + Google STUN)
# No external servers (no Agora, no LiveKit, no Oracle VM required!)
RTC_PROVIDER=webrtc

# Authentication: 100% Free dev OTP (accepts 123456 for any phone number)
OTP_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments: Free test mode (recharges credited immediately)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Moderation: 100% Free local keyword filter & dictionary translation (No Claude/Anthropic API needed)
# All checks run in-memory locally with zero cost

# Web Origins & Storage
CORS_ORIGIN=*

# Super Admin Login
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=admin12345
